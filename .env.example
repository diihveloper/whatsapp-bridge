# Port for the local HTTP service (default 4477)
PORT=4477

# Bind address — keep 127.0.0.1 unless you really need to expose to LAN
HOST=127.0.0.1

# Connection backend:
#   extension (default) — the WhatsApp connection lives in a Chrome/Chromium tab
#               via the extension in ./extension. The service runs headless and
#               only receives messages on /ingest and hands sends back via
#               /outbound. No linked device is created (lower ban risk).
#   baileys   — built-in WhatsApp socket. Registers a linked device; can trip
#               Meta's anti-abuse heuristics. Opt in explicitly.
# See the README "Como rodar" sections for the setup of each.
BRIDGE_MODE=extension

# Set to "true" to enable POST /chats/:id/messages (send).
# Read-only by default. Enabling is on your own risk.
ENABLE_SEND=false

# Optional tag prepended to outbound text/caption so recipients can tell the
# message was sent by an agent/skill/automation, not a human. Empty = off
# (default). A single space is auto-inserted between the tag and the message;
# include a non-space terminator (e.g. ":") in the tag if you want one.
# Examples:
#   SEND_AGENT_PREFIX=[Agente]      →  "[Agente] olá"
#   SEND_AGENT_PREFIX=🤖            →  "🤖 olá"
#   SEND_AGENT_PREFIX=[Agente]:     →  "[Agente]: olá"
# Per-send override: POST /chats/:id/messages body accepts `agentPrefix` —
# pass `false` to disable for one send, or a string to override the default.
# CLI: `wa send ... --no-prefix` / `wa send ... --prefix "[Bot]"`.
SEND_AGENT_PREFIX=

# Baileys log level: trace | debug | info | warn | error | fatal | silent
# Default `warn` keeps the terminal quiet. Bump to `info` or `debug` only
# when troubleshooting the WhatsApp connection itself.
BAILEYS_LOG_LEVEL=warn

# ─────────────────────────────────────────────────────────────────────────────
# Media: audio transcription, image OCR/description, document download.
# Everything is OFF by default — no media leaves your machine until you opt in
# and provide the matching key. Only the chosen provider's key is needed.
# ─────────────────────────────────────────────────────────────────────────────

# Transcribe voice notes / audio → text (folded into the message, also searchable).
#   off           — disabled (default)
#   groq          — Groq Whisper (cloud, free tier, fast)        → GROQ_API_KEY
#   openai        — OpenAI Whisper (cloud, ~US$0.006/min)        → OPENAI_API_KEY
#   whisper-local — whisper.cpp offline (private, no key; needs ffmpeg +
#                   `npm i nodejs-whisper` + `npx nodejs-whisper download`)
TRANSCRIBE_PROVIDER=off

# OCR + brief description of images (boletos, comprovantes, prints) → text.
#   off       — disabled (default)
#   claude    — Anthropic vision, OCR + description in one call  → ANTHROPIC_API_KEY
#   groq      — Groq vision (Llama)                              → GROQ_API_KEY
#   tesseract — local OCR, offline, text-only (`npm i tesseract.js`)
OCR_PROVIDER=off

# Keep raw media files in data/media/ so they can be downloaded via
# GET /chats/:id/messages/:msgId/media:
#   off       — never persist files (default; transcription/OCR still work)
#   processed — keep audio + images that were transcribed/OCR'd
#   documents — keep documents (PDF etc.) for download
#   all       — keep audio, images and documents
STORE_MEDIA=off

# API keys (fill only the one your providers above use)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional tuning
MEDIA_MAX_BYTES=20971520     # max media size to download/process (bytes; 20 MB)
TRANSCRIBE_LANGUAGE=pt       # ISO-639-1 language hint for transcription ("" = auto)
WHISPER_MODEL=base           # whisper-local model: tiny | base | small | medium | large
# Override provider models if defaults age out:
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENAI_WHISPER_MODEL=whisper-1
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────────────────────────────────────
# Digest summary (GET /digest?summarize=true / `wa digest --summarize`).
# OFF by default: /digest returns structured data and the *caller* (Claude in a
# session or a scheduled agent) summarizes it for free. Set a provider only if
# you need the bridge to return ready-made prose for a consumer without an LLM.
#   off | groq | openai | claude   (reuses the keys above)
# ─────────────────────────────────────────────────────────────────────────────
SUMMARY_PROVIDER=off
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# OPENAI_TEXT_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Per-chat memory: LLM-written daily/weekly notes per conversation (decisions,
# pending items, facts to remember). On-demand only — there's no scheduler.
# Trigger via `wa memory build <name>` / `wa memory build --all` or POST
# /memory/build. Needs SUMMARY_PROVIDER set (reuses its keys/model). Cumulative:
# each new daily memory sees the previous daily + latest weekly as prior
# context, so facts/decisions carry forward instead of being re-derived.
# ─────────────────────────────────────────────────────────────────────────────
# Minimum messages a chat must have in the period (day/week) to be eligible
# for `--all` builds. Single-chat builds also use this unless overridden.
MEMORY_MIN_MESSAGES=5

# ─────────────────────────────────────────────────────────────────────────────
# Keyword watchlist alerts. Put keywords in watchlist.txt (one per line); when an
# incoming message matches, the bridge records it (see `wa alerts`) and fires the
# channels below. Both channels are optional — leave blank to only record.
# ─────────────────────────────────────────────────────────────────────────────

# POST a JSON alert to this URL (works with ntfy.sh, Discord/Slack webhooks, or
# your own service). Payload: { title, message, keywords, chatId, chatName, body }.
ALERT_WEBHOOK_URL=

# Send the alert as a WhatsApp message to this phone/JID (e.g. your own number).
# Reuses the send path → requires ENABLE_SEND=true AND this JID in send_whitelist.txt.
ALERT_WHATSAPP_TO=

# Only alert on messages newer than this (ms), so a history backfill doesn't fire
# a storm of stale alerts. Default 15 minutes.
# ALERT_MAX_AGE_MS=900000
